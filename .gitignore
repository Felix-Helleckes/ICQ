# Dependencies
node_modules/

# Build outputs
build/
dist/

# Electron session data (WhatsApp login, Telegram session)
data/
.wwebjs_cache/
.wwebjs_auth/

# Bundled Chromium (downloaded via scripts/download-chrome.js, not committed)
puppeteer_cache/

# Environment / secrets
.env
.env.local
.env.production
.env.development
.env.*
!.env.example

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/
*.log
npm-debug.log*

# electron-builder cache
electron-builder-cache/

# Playwright / test artifacts
test-results/
playwright-report/

# Mac App Store: Provisioning Profile and certificates come from CI secrets, never from git
store/mas/embedded.provisionprofile
store/**/*.p12
store/**/*.p8
store/**/*.key
store/**/*.csr
