<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Mac App Store: App Sandbox is mandatory. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <!-- WhatsApp (Baileys) and Telegram (gramjs) connect outwards only. -->
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- Voice messages (getUserMedia). Needs NSMicrophoneUsageDescription in Info.plist. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- Attachments chosen in the open dialog, saved media. -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <key>com.apple.security.files.downloads.read-write</key>
    <true/>
  </dict>
</plist>
